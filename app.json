{
  "expo": {
    "name": "wasfa",
    "slug": "meal-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-logo.png",
    "scheme": "mealplanner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.abdelrahmanahmed.mealplanner",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.abdelrahmanahmed.mealplanner",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "mealplanner",
              "host": "import"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "text/*"
            },
            {
              "mimeType": "video/*"
            },
            {
              "mimeType": "image/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "text/*"
            },
            {
              "mimeType": "video/*"
            },
            {
              "mimeType": "image/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsMovieWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*",
            "video/*",
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "video/*",
            "image/*"
          ]
        }
      ],
      "expo-localization",
      "expo-video"
    ],
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "075d17be-4232-4a07-a8c7-42275d6cf110"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "abdelrahmanabas11493"
  }
}
