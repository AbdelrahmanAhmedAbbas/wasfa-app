# Supabase Configuration
# Get these values from your Supabase project dashboard
# Project Settings > API > Project URL and anon/public key

# IMPORTANT: Replace these with your actual Supabase credentials
# These are placeholder values - the app will work but auth won't until you add real credentials
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Import API base URL (normal backend APIs, not Supabase Edge Functions)
# Expected endpoints:
# POST /import/create
# POST /import/share
# GET  /import/status?id=...&token=...
# POST /import/confirm
EXPO_PUBLIC_IMPORT_API_BASE_URL=http://localhost:3000/api
