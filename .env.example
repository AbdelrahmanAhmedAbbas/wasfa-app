# Convex backend
# `npx convex dev` writes these to .env.local for the development deployment.
# Builds and over-the-air updates read EXPO_PUBLIC_CONVEX_URL from the EAS environment.
EXPO_PUBLIC_CONVEX_URL=

# PostHog analytics (the project API key starts with phc_ and is safe to ship in the app).
# Leave the key out of .env.local to keep local runs out of the numbers; builds and
# over-the-air updates read it from the EAS environment.
EXPO_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com (the default) or https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=

# Sentry error tracking. The DSN is safe to ship in the app; leave it out of .env.local
# to keep local runs out of the reports. Builds read it from the EAS environment.
EXPO_PUBLIC_SENTRY_DSN=
# Uploads source maps during EAS builds and updates. Secret: set it in the EAS
# environment (visibility "secret"), never in the app or this file.
SENTRY_AUTH_TOKEN=
